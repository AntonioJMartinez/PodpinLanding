{
  "hosting": {
    "public": "dist",
    "ignore": ["build-manifest.json", "_headers", "CNAME", ".nojekyll", "**/.DS_Store"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/e/**", "function": { "functionId": "shares", "region": "us-central1" } },
      { "source": "/api/shares", "function": { "functionId": "shares", "region": "us-central1" } },
      { "source": "/api/shares/**", "function": { "functionId": "shares", "region": "us-central1" } }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "test", ".git", "*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "hosting": { "port": 5050 },
    "functions": { "port": 5051 },
    "firestore": { "port": 5052 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
