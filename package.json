{
  "name": "podpin-landing",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:site",
    "build:site": "node --env-file-if-exists=.env scripts/build-site.mjs",
    "build:preview": "node scripts/build-site.mjs --preview",
    "optimize:images": "node scripts/optimize-images.mjs",
    "dev": "npm run build:preview && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "sharp": "^0.35.4"
  }
}
